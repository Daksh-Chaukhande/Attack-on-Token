# SharePlate Backend Environment Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MySQL 8)
DATABASE_URL="mysql://root:password@localhost:3306/shareplate"

# Security & Authentication
JWT_SECRET="your_super_secret_jwt_key_here"
JWT_EXPIRES_IN="1d"
REFRESH_TOKEN_SECRET="your_super_secret_refresh_token_key_here"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Background Expiration Worker
EXPIRY_WORKER_INTERVAL_MS=60000

# Optional Email / Notification Transport
# Options: 'memory_log' (development fallback) or 'smtp'
EMAIL_PROVIDER="memory_log"
SMTP_HOST="localhost"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="notifications@shareplate.local"
